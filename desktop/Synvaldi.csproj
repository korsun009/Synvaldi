<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <Version>0.1.0</Version><DefineConstants>$(DefineConstants);VIVALDI_METADATA</DefineConstants><AssemblyName>Synvaldi</AssemblyName>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('../browser/ColdWorkspaces.cs')"><DefineConstants>$(DefineConstants);COLD_WORKSPACES</DefineConstants></PropertyGroup>
  <ItemGroup>
    <Compile Include="../browser/ColdWorkspaces.cs" Condition="Exists('../browser/ColdWorkspaces.cs')" Link="ColdWorkspaces.cs" />
    <ProjectReference Include="../integrations/Synvaldi.Integrations.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <Compile Include="../browser/VivaldiMetadata.cs" Link="VivaldiMetadata.cs" /><Compile Remove="NativeHost/**;Tests/**" />
    <EmbeddedResource Remove="NativeHost/**;Tests/**" /><None Remove="NativeHost/**;Tests/**" />
    <InternalsVisibleTo Include="Synvaldi.Tests" />
    <Resource Include="Assets/*.png;Assets/app.ico" />
  </ItemGroup>
</Project>